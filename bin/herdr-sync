#!/usr/bin/env python3
"""Sync personal Herdr app config between this repo and the live Herdr home.

    herdr-sync status    show what differs between the repo and the live config
    herdr-sync capture   copy live -> repo (mirror: removes repo files deleted live)
    herdr-sync install   copy repo -> live (never deletes live files; backs up overwrites)

Only files you own are synced. Herdr's shipped layouts and mods (listed in its
installed.json), its shipped themes, AGENTS.md, the .d.ts files, frame/, icons/
and all state Herdr writes itself (view.json, shared.json, layouts/.state, ...)
are left alone.
"""
import filecmp
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CONFIG = REPO / "config"
LIVE = Path(os.environ.get("HERDR_APP_HOME") or Path.home() / ".config" / "herdr-app")

TOP_FILES = ["keys.json", "settings.json", "programs.json"]
ASSET_DIRS = ["fonts", "backgrounds", "sounds", "my-icons"]  # your own assets, if any
SHIPPED_THEMES = {"atom-one-dark", "win98"}
SKIP_NAMES = {"node_modules", "jsconfig.json", ".DS_Store"}
SKIP_SUFFIXES = (".d.ts", ".error")
SKIP_MARKERS = (".old-", ".reset-", ".corrupt-")


def shipped():
    try:
        names = json.loads((LIVE / "installed.json").read_text())
    except (OSError, ValueError):
        sys.exit(f"can't read {LIVE / 'installed.json'}: is Herdr installed and started once?")
    mods = {n for n in names if not n.startswith("layout:")}
    layouts = {n.split(":", 1)[1] for n in names if n.startswith("layout:")}
    return mods, layouts


def skip(path: Path) -> bool:
    return (
        any(p.startswith(".") or p in SKIP_NAMES for p in path.parts)
        or path.name.endswith(SKIP_SUFFIXES)
        or any(m in path.name for m in SKIP_MARKERS)
    )


def files_under(root: Path, rel: Path):
    base = root / rel
    if base.is_file():
        yield rel
    elif base.is_dir():
        for p in sorted(base.rglob("*")):
            r = p.relative_to(root)
            if p.is_file() and not skip(r):
                yield r


def owned(root: Path):
    """Relative paths of user-owned files present under root."""
    mods, layouts = shipped()
    out = set()
    for f in TOP_FILES:
        out.update(files_under(root, Path(f)))
    for d in ASSET_DIRS:
        out.update(files_under(root, Path(d)))
    if (root / "layouts").is_dir():
        for p in (root / "layouts").iterdir():
            if p.is_file() and p.name.split(".", 1)[0] not in layouts:
                out.update(files_under(root, p.relative_to(root)))
    if (root / "themes").is_dir():
        for p in (root / "themes").iterdir():
            if p.is_file() and p.stem not in SHIPPED_THEMES:
                out.update(files_under(root, p.relative_to(root)))
    if (root / "mods").is_dir():
        for p in (root / "mods").iterdir():
            if p.is_dir() and p.name not in mods:
                out.update(files_under(root, p.relative_to(root)))
    return out


def same(a: Path, b: Path) -> bool:
    return a.is_file() and b.is_file() and filecmp.cmp(a, b, shallow=False)


def changes():
    live, repo = owned(LIVE), owned(CONFIG)
    return (
        sorted(live - repo),  # only live
        sorted(repo - live),  # only repo
        sorted(p for p in live & repo if not same(LIVE / p, CONFIG / p)),
    )


def on_default_branch() -> bool:
    try:
        branch = subprocess.run(["git", "-C", str(REPO), "branch", "--show-current"],
                                capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return False
    return branch in ("main", "master")


def cmd_status():
    only_live, only_repo, differ = changes()
    for p in only_live:
        print(f"  live only   {p}")
    for p in only_repo:
        print(f"  repo only   {p}")
    for p in differ:
        print(f"  differs     {p}")
    if not (only_live or only_repo or differ):
        print("in sync")


def cmd_capture():
    if on_default_branch() and not os.environ.get("HERDR_SYNC_ALLOW_MAIN"):
        sys.exit("refusing to capture onto the default branch: run this in a worktree/branch")
    only_live, only_repo, differ = changes()
    for p in only_live + differ:
        (CONFIG / p).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(LIVE / p, CONFIG / p)
        print(f"  captured    {p}")
    for p in only_repo:
        (CONFIG / p).unlink()
        print(f"  removed     {p}")
    for d in sorted(CONFIG.rglob("*"), reverse=True):
        if d.is_dir() and not any(d.iterdir()):
            d.rmdir()
    if not (only_live or only_repo or differ):
        print("nothing to capture")


def cmd_install():
    _, only_repo, differ = changes()
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup = LIVE / ".herdr-sync-backup" / stamp
    for p in differ:
        (backup / p).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(LIVE / p, backup / p)
    for p in only_repo + differ:
        (LIVE / p).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(CONFIG / p, LIVE / p)
        print(f"  installed   {p}")
    if differ:
        print(f"previous versions saved in {backup}")
    if not (only_repo or differ):
        print("nothing to install")
    errors = sorted(LIVE.glob("*.error"))
    for e in errors:
        print(f"!! {e.name}: {e.read_text().strip()}")


def main():
    cmds = {"status": cmd_status, "capture": cmd_capture, "install": cmd_install}
    if len(sys.argv) != 2 or sys.argv[1] not in cmds:
        sys.exit(__doc__)
    cmds[sys.argv[1]]()


if __name__ == "__main__":
    main()
